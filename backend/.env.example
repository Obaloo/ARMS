PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/arms?retryWrites=true&w=majority
FRONTEND_URL=https://arms-six.vercel.app
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_RESET_SECRET=change_me_reset_secret

# Gmail SMTP Configuration (REQUIRED for email functionality)
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account settings → Security → 2-Step Verification → App passwords
# 3. Generate a 16-character app password
# 4. Use the app password as SMTP_PASS (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-digit-app-password-here
SMTP_FROM=ARMS <your-gmail@gmail.com>

NODE_ENV=production
